# File này quyết định thứ KHÔNG được copy vào image.
# Bỏ sót .env = leak secret vào image. Bỏ sót .git = image phình to.

# Git
.git
.gitignore
.github

# Secret
.env
.env.*
!.env.example

# Python
__pycache__
*.pyc
*.pyo
.venv
venv
.pytest_cache
.mypy_cache
.ruff_cache

# Không cần trong image
tests
screenshots
*.md
Dockerfile
docker-compose.yml
.dockerignore
.vscode
.idea
